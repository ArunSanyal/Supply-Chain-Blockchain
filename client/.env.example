# Copy to client/.env (which is gitignored) and adjust.
#
# RPC endpoint used to read the contract when no wallet is connected (read-only mode).
# Create React App bakes REACT_APP_* values into the JavaScript bundle, so anyone using
# the app can see this URL. Don't put a private API key here.
REACT_APP_RPC_URL=http://127.0.0.1:8545
